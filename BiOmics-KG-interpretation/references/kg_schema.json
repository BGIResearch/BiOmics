  "evidence_boundary": {
    "default_kg_relation_policy": "curated_preferred",
    "default_weak_evidence_policy": "snippet_supported",
    "allow_weak_final_types": [
      "factoid",
      "list"
    ],
    "co_mentioned_max_share": 0.15,
    "co_mentioned_max_rows_per_question": 3,
    "evidence_tiers": {
      "E3": "strong_curated",
      "E2": "snippet_supported_weak",
      "E1": "weak_trace",
      "E0": "drop_or_background"
    },
    "weak_trace_answer_role": "weak_trace",
    "snippet_supported_weak_answer_role": "support_evidence_or_capped_candidate",
    "strong_curated_answer_role": "candidate_answer",
    "background_answer_role": "background_context",
    "drop_answer_role": "dropped",
    "mcq": {
      "candidate_side": "source",
      "option_anchor": "hard",
      "allow_drop_option": false,
      "fallback_when_no_strong_evidence": "native_llm"
    },
    "list": {
      "direct_answer_first": true,
      "max_kg_added_answers": 3,
      "co_mentioned_only_can_add_answer": false,
      "snippet_supported_weak_max_added": 3
    },
    "factoid": {
      "snippet_supported_weak_max_added": 1
    },
    "path_answer_set": {
      "co_mentioned_can_be_main_path_edge": false,
      "fallback_co_mentioned_is_diagnostic_only": true
    }
  },
