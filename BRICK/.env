# Copy to .env and fill in your credentials.
EMBEDDING_API_KEY=sk-kpsteSkpDGl1xBmDEcC7D51b968e43499092826f17286b55
EMBEDDING_BASE_URL=http://10.224.28.80:3000/v1
EMBEDDING_MODEL=text-embedding-v3

# Elasticsearch connection settings
# 若连接云端集群，可直接填充 ES_CONFIG（JSON）；hosts、username、password 可根据实际情况覆盖
ES_CONFIG="{\"hosts\": [\"http://es-cn-uax3fxy8w000e2tuf.elasticsearch.aliyuncs.com:9200\"], \"username\": \"elastic\", \"password\": \"3fg51u8ZyRYWUxPXwVpl\"}"
# 可自定义前缀避免覆盖共享索引
ES_INDEX_PREFIX=brick_index_*
ES_VERIFY_CERTS=true

# --- Hybrid Search （混合检索模块专用） ---
# 模糊混合检索使用的 ES 索引名，可覆盖默认值
HYBRID_ES_INDEX=brick_index_*
# 默认整合返回数量；不填写时代码内将回退至 10
HYBRID_TOP_K=10
# 类型权重 JSON，参考 target_plan.md 中的默认配置
HYBRID_TYPE_MIX={"Gene|Protein":0.25,"Disease|Phenotype":0.25,"Process|Function|Pathway|Cell_Component":0.20,"Chemical":0.10,"Species":0.10,"Cell|Tissue":0.10,"Mutation":0.0}
HYBRID_EMBEDDING_ENDPOINT=${EMBEDDING_BASE_URL}  # 若需要独立的 embedding 服务，可在此覆盖
HYBRID_EMBEDDING_MODEL=${EMBEDDING_MODEL}        # 允许单独指定 embedding 模型，默认复用 text-embedding-v3